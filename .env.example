# Postgres container (compose.yml)
POSTGRESQL_USERNAME=
POSTGRESQL_PASSWORD=
POSTGRESQL_DATABASE=

# App
DATABASE_URL="postgresql://<user>:<password>@localhost:5555/<database>"
JWT_SECRET=
JWT_EXPIRES_IN=1d
PORT=3000

# Optional: admin created by `npx prisma db seed`
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
